# Non-secret configuration. Secrets are injected by `bws run`.
BUFFER_CHANNEL_LINKEDIN=replace-with-your-buffer-channel-id
BUFFER_CHANNEL_X=replace-with-your-buffer-channel-id
BUFFER_CHANNEL_FACEBOOK=replace-with-your-buffer-channel-id
BLUESKY_HANDLE=replace-with-your-handle.bsky.social
MASTODON_API_BASE_URL=https://replace-with-your-mastodon-instance
SOCIAL_LATE_WINDOW_MINUTES=15
SOCIAL_POST_DELAY_SECONDS=30
# Opt in to Buffer's next-available queue slot instead of CSV dueAt times.
BUFFER_USE_QUEUE=0
# Buffer free plan: maximum scheduled posts per channel.
BUFFER_MAX_SCHEDULED_PER_CHANNEL=10
